{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "unicorn/prefer-node-protocol": "error",
    "promise/no-return-wrap": "error",

    // Retry loops and cleanup sequences await on purpose: the whole point is
    // that attempt N+1 happens after attempt N, so Promise.all is wrong here.
    "eslint/no-await-in-loop": "off",

    // Small helpers live next to the one function that uses them on purpose;
    // hoisting them out to save an allocation costs more in readability.
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    }
  ]
}
