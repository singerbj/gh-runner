{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["DOCS_BASE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/gh-runner/package.json",
        "$TURBO_ROOT$/packages/gh-runner/deploy/**",
        "$TURBO_ROOT$/packages/gh-runner/prompts/**"
      ]
    }
  }
}
