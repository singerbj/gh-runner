{
  "name": "gh-runner-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the gh-runner CLI and its landing page",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singerbj/gh-runner.git"
  },
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "audit": "better-npm-audit audit --level moderate",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "better-npm-audit": "^3.11.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
